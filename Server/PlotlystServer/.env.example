# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017
DATABASE_NAME=plotlyst

# HTTP server
PORT=8080
ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Generate two different values with: openssl rand -hex 32
SECRET_KEY=replace-with-at-least-32-random-characters
SECRET_REFRESH_KEY=replace-with-a-different-32-character-secret

# Recommendations
RECOMMENDED_MOVIE_LIMIT=5

# Optional: leave blank to use the offline review classifier
OPENAI_API_KEY=
BASE_PROMPT_TEMPLATE="Classify the following movie review using exactly one of these rankings: {rankings}. Return only the ranking name. Review: "

# Step 6 intent extraction. `offline` never calls an AI provider.
AI_PROVIDER=offline
AI_MODEL=gpt-4.1-mini
AI_TIMEOUT=8s
AI_MAX_INPUT_CHARS=800
AI_MAX_OUTPUT_TOKENS=350
AI_DAILY_USER_BUDGET=20
AI_CACHE_TTL=30m

# Optional licensed OpusData/The Numbers adapter. Both values must be supplied.
# When blank and demo is enabled, box-office pages are visibly marked synthetic.
OPUSDATA_API_KEY=
OPUSDATA_BASE_URL=
OPUSDATA_TIMEOUT=8s
BOX_OFFICE_DEMO_ENABLED=true

# TMDB catalogue integration. Create a v3 API key at https://www.themoviedb.org/settings/api
# Never expose this value through VITE_* variables or commit a real key.
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_TIMEOUT=8s
TMDB_CACHE_TTL=10m
TMDB_MAX_RETRIES=3
